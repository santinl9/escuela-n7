NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=libreria_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}

CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1

# --- Autenticacion ---
# Secreto de firma de los JWT. En produccion debe ser un valor largo y aleatorio.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
# Duracion del token (formato de la libreria `ms`: 15m, 1h, 1d, 7d).
JWT_EXPIRES_IN=1d
# Costo de hasheo de bcrypt (10 es el estandar; mas alto = mas lento).
BCRYPT_ROUNDS=10
